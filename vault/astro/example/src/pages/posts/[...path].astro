---
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const routes = new Set();
  return (await getCollection('essays')).map(entry => {
    const path = decodeURIComponent(entry.data.permalink.slice('/posts/'.length));
    if (routes.has(path)) throw new Error(`Duplicate ohm permalink ${entry.data.permalink}; choose unique post slugs`);
    routes.add(path);
    return { params: { path }, props: { entry } };
  });
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{entry.data.title || entry.id}</title>
    <link rel="canonical" href={entry.data.canonicalUrl} />
    <link rel="site.standard.document" href={entry.data.uri} />
  </head>
  <body><a href="/">Essays</a><h1>{entry.data.title}</h1><Content /></body>
</html>
