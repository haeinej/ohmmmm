# Policy for a cortex kept in git. Agents do not edit this file.

# A version is worked out from a file's exact text, so line endings are the same on every machine.
* text=auto eol=lf

# The journal is only ever added to, one line each, and every line has its own ID, so two
# machines' lines are both kept.
.cortex/journal.jsonl merge=union

# Observations from before the journal, then called notes. Read, never written again.
.cortex/notes.jsonl merge=union

# Nothing in secrets is shown in a diff, should a file there ever be added by force.
agents/secrets/** -diff

# Profile proposals and answers are only ever added to, one line each, so two machines' lines are both kept.
.cortex/profile.jsonl merge=union

# Identity changes from before docs/model.md. Read, never written again.
.cortex/identity.jsonl merge=union

# Session starts and asks from before the journal. Read, never written again.
.cortex/sessions.jsonl merge=union
