# Policy for a cortex kept in git. Agents do not edit this file.

# Secrets never leave the machine they were put on.
agents/secrets/*
!agents/secrets/.gitkeep

# Files half written, and what the operating system leaves behind.
*.tmp
.DS_Store
Thumbs.db

# Which vault this machine reads, and how far it has read it. Each machine connects its own.
.cortex/vault.json
.cortex/vault-cursor.json

# The lock a write holds while it runs, on this machine.
.cortex/write.lock

# The hooks' checkpoints for this machine's sessions: when to ask an agent for observations.
.cortex/hooks.jsonl
